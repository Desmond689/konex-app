# Copy to .env and fill with real values. NEVER commit .env.
# Use SEPARATE Supabase projects for development / staging / production.

APP_ENV=development
# APP_ENV=staging
# APP_ENV=production

# Development Supabase project (anon key only — never service_role)
SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_dev_anon_key_here

# Staging (set when APP_ENV=staging)
# SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_staging_anon_key_here

# Production (set when APP_ENV=production)
# SUPABASE_URL=https://YOUR_PROD_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_prod_anon_key_here

ENABLE_LOGGING=true
APP_VERSION=0.1.0
BUILD_NUMBER=1

# Optional client-safe config (no secrets)
# API_VIDEO_PUBLIC_ID=...   # never put api.video secret here
